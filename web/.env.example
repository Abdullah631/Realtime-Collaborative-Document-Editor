# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key. Safe to expose: the database grants it nothing.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Express + Hocuspocus server (WebSocket URL is derived: http->ws, https->wss)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: enables one-click demo logins. Must equal DEMO_PASSWORD used by `npm run seed`.
NEXT_PUBLIC_DEMO_PASSWORD=
