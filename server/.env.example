PORT=4000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> secret key (or legacy service_role). Server only!
SUPABASE_SECRET_KEY=sb_secret_xxx
# Only used by `npm run migrate`. Supabase -> Connect -> Session pooler URI (not "Direct connection": IPv6-only on free tier)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Comma-separated frontend origins allowed to call the API
WEB_ORIGINS=http://localhost:3000
# Only used by `npm run seed` to create the demo accounts
DEMO_PASSWORD=change-me-demo-password
